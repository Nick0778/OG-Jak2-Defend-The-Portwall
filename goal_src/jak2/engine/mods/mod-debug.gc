;;-*-Lisp-*-
(in-package goal)

;; For debug-only additions to the mod-base. Anything defined in this file will be unavailable in retail mode.
(declare-file (debug))

;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Additional debug menu(s)
;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun-debug debug-menu-make-modding-tools-menu ((ctx debug-menu-context))
  (let ((modding-tools-menu (new 'debug 'debug-menu ctx "Modding Tools")))

    ;; orb-placer menu
    (let ((orb-placer-menu (new 'debug 'debug-menu ctx "Orb Placer")))
      (debug-menu-append-item orb-placer-menu (new-dm-bool "Edit Mode?" *orb-placer-enabled?* dm-boolean-toggle-pick-func))
      (debug-menu-append-item orb-placer-menu (new-dm-func "Add Orb" #f orb-placer-add))
      (let ((select-orb-menu (new 'debug 'debug-menu ctx "Select Orb")))
        (set! *orb-placer-select-menu* select-orb-menu)
        ;; populated on orb add
        (debug-menu-append-item orb-placer-menu (new-dm-submenu "Select Orb" select-orb-menu))
        )
      (debug-menu-append-item orb-placer-menu (new-dm-func "Print Selected Orb Position" #f orb-placer-print-selected))
      (debug-menu-append-item orb-placer-menu (new-dm-func "Print All Orb Positions" #f orb-placer-print-all))

      (debug-menu-append-item modding-tools-menu (new-dm-submenu "Orb Placer" orb-placer-menu))
      )

    ;; nick-nav-editor menu
    (let ((nick-nav-editor-menu (new 'debug 'debug-menu ctx "Nav Graph Editor")))
      (debug-menu-append-item nick-nav-editor-menu (new-dm-func "Start Editor" #f start-nick-nav-editor)) ;; start the editor
      (debug-menu-append-item nick-nav-editor-menu (new-dm-func "Stop Editor" #f stop-nick-nav-editor)) ;; stop the editor
      (debug-menu-append-item nick-nav-editor-menu (new-dm-bool "Toggle Preview Edge Mode" *nick-nav-toggle-preview-edge?* dm-boolean-toggle-pick-func))
      (let ((select-edit-mode-menu (new 'debug 'debug-menu ctx "Editor Mode")))
        (debug-menu-append-item select-edit-mode-menu
          (new-dm-bool "Path" 
            #f 
            (lambda ((item debug-menu-item) (msg debug-menu-msg))
              (if (= msg (debug-menu-msg press))
                (nick-nav-menu-set-edit-mode (nick-nav-edit-mode path))
                )
              (nick-nav-menu-get-edit-mode (nick-nav-edit-mode path))
              )
            )
          )
        (debug-menu-append-item select-edit-mode-menu
          (new-dm-bool "Nav Network" 
            #f 
            (lambda ((item debug-menu-item) (msg debug-menu-msg))
              (if (= msg (debug-menu-msg press))
                (nick-nav-menu-set-edit-mode (nick-nav-edit-mode nav-network))
                )
              (nick-nav-menu-get-edit-mode (nick-nav-edit-mode nav-network))
              )
            )
          )
        (debug-menu-append-item nick-nav-editor-menu (new-dm-submenu "Editor Mode" select-edit-mode-menu))
        )
      (let ((select-path-type-menu (new 'debug 'debug-menu ctx "Path Type")))
        (debug-menu-append-item select-path-type-menu 
          (new-dm-bool "Linear" 
            #f 
            (lambda ((item debug-menu-item) (msg debug-menu-msg))
              (if (= msg (debug-menu-msg press))
                (nick-nav-menu-set-path-type (nick-nav-path-type linear))
                )
              (nick-nav-menu-get-path-type (nick-nav-path-type linear))
              )
            )
          )
        (debug-menu-append-item select-path-type-menu 
          (new-dm-bool "Curved" 
            #f 
            (lambda ((item debug-menu-item) (msg debug-menu-msg))
              (if (= msg (debug-menu-msg press))
                (nick-nav-menu-set-path-type (nick-nav-path-type curved))
                )
              (nick-nav-menu-get-path-type (nick-nav-path-type curved))
              )
            )
          )
        (debug-menu-append-item nick-nav-editor-menu (new-dm-submenu "Path Type" select-path-type-menu))
        )
      (debug-menu-append-item nick-nav-editor-menu (new-dm-func "Clear All" #f nick-nav-menu-check-clear-all)) ;; clear all the graph
      (debug-menu-append-item nick-nav-editor-menu (new-dm-func "Print Graph Data" #f nick-nav-menu-print-jsonc-graph-data)) ;; print graph data
      (debug-menu-append-item modding-tools-menu (new-dm-submenu "Nav Graph Editor" nick-nav-editor-menu))
      )
    (new-dm-submenu "Modding Tools" modding-tools-menu)
    )
  )

(when (-> *debug-menu-context* root-menu)
  (debug-menu-append-item (-> *debug-menu-context* root-menu) (debug-menu-make-modding-tools-menu *debug-menu-context*))
  )